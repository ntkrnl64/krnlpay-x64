  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "hash-password": "bun scripts/hash-password.ts",
    "test": "bun test",
    "check": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.66.0",
    "@fluentui/react-icons": "^2.0.343",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.13.0",
    "@cloudflare/workers-types": "^4.20250926.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/node": "^24.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.36.0"
  }
}
